# ===== Для сервера (docker compose) =====
# Домен панелі (A-запис домену має вказувати на IP сервера)
DOMAIN=panel.example.com
PUBLIC_URL=https://panel.example.com

# Вхід адміністратора платформи (діє при першому запуску)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Ключ Claude для генерації інвайтів (можна також задати окремо для агенції в Налаштуваннях)
ANTHROPIC_API_KEY=

# 0 — вимкнути вбудований демо-сайт (на робочому сервері рекомендовано)
DEMO_SITE=0

# ===== Лише для запуску без Docker (start.bat / npm start) =====
# PORT=3000
# DATA_DIR=./data

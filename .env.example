# Налаштування сервера. Локально — файл .env поруч із package.json; на Railway — Variables сервісу.
# Секрети (паролі, ключі, токени) — лише тут або в Variables, ніколи в git.

# Вхід адміністратора платформи (діє при першому запуску)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Telegram-бот платформи (або вставити токен в адмінці: «Telegram і функції»)
# TELEGRAM_BOT_TOKEN=

# Ключ Claude платформи (тімлід може поставити свій ключ команди в панелі)
# ANTHROPIC_API_KEY=

# Пошта для «Забули пароль?» (без неї посилання приходить лише в Telegram)
# SMTP_URL=smtps://login%40gmail.com:app-password@smtp.gmail.com:465
# MAIL_FROM=Agency CRM <login@gmail.com>

# 0 — без вбудованого демо-сайту (на Railway; локально для тестів демо-сайт потрібен)
# DEMO_SITE=0

# Лише локально (Railway задає це сам)
# PORT=3000
# DATA_DIR=./data

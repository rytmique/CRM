# Порт і публічна адреса панелі (її вшиває в архів розширення)
PORT=3000
PUBLIC_URL=https://panel.example.com

# Де зберігається база SQLite
DATA_DIR=./data

# Адміністратор платформи (створюється при першому запуску)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Ключ Claude для генерації інвайтів (можна також задати окремо для кожної агенції в Налаштуваннях)
ANTHROPIC_API_KEY=

# 0 — вимкнути вбудований демо-сайт для тестування бота
DEMO_SITE=1

{
  "manifest_version": 3,
  "name": "Agency Bot — інвайти з анкет",
  "short_name": "Agency Bot",
  "version": "1.1.0",
  "description": "Розсилає інвайт-повідомлення з анкети на сайті знайомств і повідомляє про відповіді. Переписку веде жива людина.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agency Bot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}